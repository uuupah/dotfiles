color-link default "#D3C6AA,#2d353b"              #fg, bg
color-link comment "#859289,#2d353b"              #gray 1, bg
color-link symbol "#D3C6AA,#2d353b"               #fg, bg
color-link constant "#D699B6,#2d353b"             #brightmagenta, bg
color-link constant.string "#DBBC7F,#2d353b"      #yellow, bg
color-link constant.string.char "#DBBC7F,#2d353b" #yellow, bg
color-link identifier "#A7C080,#2d353b"           #green, bg
color-link statement "#E67E80,#2d353b"            #red, bg # maybe should be light red
color-link preproc "#bf616a,#2d353b"              #red, bg
color-link type "#dc7a7e,#2d353b"                 #red, bg
color-link special "#E67E80,#2d353b"              #red, bg
color-link underlined "#bf616a"                   #red
color-link error "#E67E80,#2d353b"                #red, bg
color-link hlsearch "#2d353b,#fe8019"             #bg, 
color-link diff-added "#a3be8c"                   #green
color-link diff-modified "#ebcb8b"                #yellow
color-link diff-deleted "#E67E80"                 #red
color-link gutter-error "#E67E80,#2d353b"         #red, bg
color-link gutter-warning "#dc7a7e,#2d353b"       #red, bg
color-link line-number "#859289,#2d353b"          #gray 1, bg
color-link current-line-number "#d3c6aa,#3D484D"  #fg, bg2 (bg2 is two steps lighter than bg)
color-link cursor-line "#3D484D"                  #bg2
color-link color-column "#4c566a"                 #bg3
color-link statusline "#859289,#232A2E"           #gray 1, bg dim
color-link tabbar "#d8dee9,#4c566a"               #gray 1, bg3 (its actually way lighter than gray 1 but we dont need more fucking colours)
color-link todo "#E57E00,#2d353b"                 #orange, bg
