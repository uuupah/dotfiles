color-link comment "brightblue"
# color-link comment.bright ""
color-link identifier "cyan"
color-link identifier.class "yellow" # also used for functions
# color-link identifier.macro ""
# color-link identifier.var ""
color-link constant "yellow"
# color-link constant.bool ""
# color-link number ""
# color-link specialchar ""
color-link constant.string "green"
# color-link string.url ""
color-link statement "yellow"
color-link symbol "yellow"
color-link symbol.brackets "default"
color-link preproc "magenta"
# color-link preproc.shebang "comment"
color-link type "magenta"
color-link type.extended "default"
color-link type.keyword "yellow"
color-link special "magenta"
# color-link underlined ""
color-link error "black,brightred"
color-link todo "black,brightyellow"
color-link ignore "default"
color-link hlsearch "black,yellow"
color-link statusline "black,white"
color-link indent-char "black"
color-link line-number "brightblack"
color-link current-line-number "white,black"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link gutter-error ",red"
color-link gutter-warning "red"
color-link cursor-line "black,white"
color-link color-column "white"
color-link match-brace ",magenta"
color-link tab-error "brightred"
color-link trailingws "brightred"
