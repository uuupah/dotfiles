// -*- mode: jsonc -*-
[
	{
		"output": "!HDMI-A-1",
		"reload_style_on_change": true,
		//"height": 24, // Waybar height (to be removed for auto height)
		"spacing": 0, // Gaps between modules (4px)
		"margin": 0,
		"modules-left": [
			"niri/workspaces",
			"custom/pipe-divider",
			"niri/window"
		],
		"modules-right": [
			"custom/gap",
			"custom/nowplaying",
			// "custom/pipe-divider", // this divider is rendered by the script so it gets hidden when no music is playing
		    "custom/idle",
   			"custom/spacer",
			"bluetooth",
			"custom/spacer",
			"pulseaudio#mic",
			"custom/pipe-divider",
			"network",
			"custom/pipe-divider",
			"pulseaudio#vol",
			"custom/spacer",
			"cpu",
			"custom/spacer",
			"memory",
			// "custom/spacer", // this space has been attached to the battery entry
			"battery",
			"custom/pipe-divider",
			"clock",
			"custom/pipe-divider",
			"tray"
		],
		"custom/spacer": {
			"format": " ",
			"tooltip": false,
		},
		"custom/gap": {
			"format": "      ",
			"tooltip": false,	
		},
		"custom/pipe-divider": {
			"format": " | ",
			"tooltip": false,
		},
		"custom/hyphen-divider": {
			"format": " - "
		},
		"niri/window": {
			"tooltip": false,
			"swap-icon-label": false
		},
		"custom/idle": {
			"tooltip": false,
			"return-type": "text",
			"exec": "/home/uuu/.config/waybar/scripts/check_idle_inhibit.sh",
			"interval": 60,
			"on-click": "/home/uuu/.config/waybar/scripts/toggle_idle_inhibit.sh"
		},
		"custom/nowplaying": {
			"format": "{}",
			"return-type": "text",
			"exec": "/home/uuu/.config/waybar/scripts/quodlibet-now-playing.sh",
			"interval": 1,
			"on-click": "quodlibet --play-pause",
			"tooltip": false
		},
		"cpu": {
			"format": "cpu {usage:02d}",
			"tooltip": false,
			"interval": 5
		},
		"memory": {
			"format": "mem {percentage:02d}",
			"tooltip": false,
			"interval": 5
		},
		"idle_inhibitor": {
			"format": "{icon}",
			"format-icons": {
				"activated": "",
				"deactivated": ""
			}
		},
		"idle_inhibitor": {
			"format-icons": {
				"activated": "idle off",
				"deactivated": "idle on"
			},
			"timeout": 180
		},
		"tray": {
			"spacing": 10
		},
		"clock": {
			"interval": 1,
			"tooltip-format": "{calendar}",
			"format": "{:%Y年%m月%d日 %H:%M:%S}"
		},
		"temperature": {
			"critical-threshold": 80,
			"format": "{temperatureC}°C {icon}",
			"format-icons": [
				"",
				"",
				""
			]
		},
		"backlight": {
			"format": "{percent}% {icon}",
			"format-icons": [
				"",
				"",
				""
			]
		},
		"battery": {
			"interval": 30,
			"format": " bat {capacity} {time}",
			"format-time": "({H}:{m})",
			"format-full": " bat {capacity}",
			"format-charging": " chg {capacity} {time}",
			"format-plugged": " chg {capacity} {time}",
		},
		"battery#bat2": {
			"bat": "BAT2"
		},
		"power-profiles-daemon": {
			"format": "{icon}",
			"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
			"tooltip": true,
			"format-icons": {
				"default": "",
				"performance": "",
				"balanced": "",
				"power-saver": ""
			}
		},
		"network": {
			"format-wifi": "{essid:.10} {signalStrength}",
			"format-ethernet": "eth {ipaddr}",
			"tooltip-format": "{essid}\n{ifname} via {gwaddr}",
			"format-linked": " {ifname} (No IP)",
			"format-disconnected": "no wifi",
			"format-disabled": "wifi off",
			"on-click": "alacritty -e nmcli device wifi rescan; alacritty -e nmtui",
		},
		"bluetooth": {
			"format": "bt on",
			"format-off": "bt off",
			"format-disabled": "bt off",
			"format-connected": "bt {num_connections}",
			"on-click": "blueman-manager",
			"tooltip-format": "{status}"
		},
		"pulseaudio#vol": {
			// "scroll-step": 1, // %, can be a float
			"format": "vol {volume}",
			"format-muted": "mute",
			"on-click": "pavucontrol"
		},
		"pulseaudio#mic": {
			"format": "{format_source}",
			"format-source": "mic on",
			"format-source-muted": "mic off",
			"on-click": "~/.config/dunst/dunst-media-control mic_mute",
			"tooltip": false
		},
		"include": [
			"~/.config/waybar/device.jsonc"
		]
	},
	{
		"output": "HDMI-A-1",
		"reload_style_on_change": true,
		"height": 24, // Waybar height (to be removed for auto height)
		"spacing": 0, // Gaps between modules (4px)
		"margin": 0,
		"modules-left": [
			"niri/workspaces",
			"custom/pipe-divider",
			"niri/window"
		],
		"modules-right": [
			"clock"
		],
		"custom/pipe-divider": {
			"format": "|",
			"tooltip": false,
		},
		"clock": {
			"interval": 1,
			"tooltip-format": "{calendar}",
			"format": "{:%Y年%m月%d日 %H:%M:%S}"
		},
		"niri/window": {
			"tooltip": false,
			"swap-icon-label": false
		}
	}
]
