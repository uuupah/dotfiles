// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  "height": 16, // Waybar height (to be removed for auto height)
  "spacing": 0, // Gaps between modules (4px)
  "margin":0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/scratchpad",
    "custom/pipe-divider",
    "hyprland/window",
    "custom/window-state"
  ],
  //"modules-center": [
    // "custom/media"
  //],
  "modules-right": [
    "custom/spacer",
    "custom/pomodoro",
    "custom/pipe-divider",
    "battery",
    "custom/pipe-divider",
    "pulseaudio",
    "custom/pipe-divider",
    "bluetooth",
    "custom/pipe-divider",
    "network",
    "custom/pipe-divider",
    "cpu",
    "custom/pipe-divider",
    "memory",
    "sway/language",
    //        "backlight",
    "custom/pipe-divider",
    "clock",
    "tray"
    //"custom/power"
  ],
  "custom/spacer": {
    "format": "        "
  },
  "custom/pipe-divider": {
    "format": "|"
  },
  "custom/hyphen-divider": {
  	"format": " - "
  },
  "custom/window-state": {
    "exec": "bash -c '/home/uuu/.config/waybar/scripts/window-state.sh'",
    "return-type": "json",
    "interval": 1
  },
  "custom/weather": {
    "exec": "bash -c 'cat /tmp/weather'",
    "return-type": "text",
    "interval": 60
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    },
    "format": {
      "special": "s"
    },
    "show-special": true
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  "custom/pomodoro": {
    "format": "pom {} ",
    "return-type": "json",
    "exec": "waybar-module-pomodoro --no-icons --no-work-icons --autow --autob",
    "on-click": "waybar-module-pomodoro toggle",
    "on-click-right": "waybar-module-pomodoro reset"
  },
  "hyprland/window": {
    "format": "{class}",
    "icon": false,
    "icon-size": 24,
    "max-length": 30,
    "rewrite": {
      "(.*)LibreWolf": "librewolf",
      "Alacritty": "alacritty",
      "Microsoft-edge":"edge",
      "dev.zed.Zed": "zed",
      "org.pulseaudio.pavucontrol": "volume control",
      "org.keepassxc.KeePassXC": "keepassxc",
      "org.remmina.Remmina": "remmina",
      "com.github.taiko2k.tauonmb": "tauon",
      "Io.github.ungoogled_software.ungoogled_chromium": "ungoogled chromium",
      "xdg-desktop-portal-gtk":"file explorer",
      "Code":"vscode"
    }
  },
  "cpu": {
    "format": "cpu {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "mem {}%"
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "interval": 1,
    "tooltip-format": "{calendar}",
    "format": "{:%Y年%m月%d日 %H:%M:%S}"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""]
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", ""]
  },
  "battery": {
    "interval": 1,
//    "states": {
//      "warning": 30,
//      "critical": 15
//    },
    "format": "bat {capacity}% {time}",
    "format-time": "({H}:{m})",
    "format-full": "bat {capacity}%",
    "format-charging": "chg {capacity}% {time}",
    "format-plugged": "chg {capacity}% {time}",
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-wifi": "wifi {signalStrength}%",
    "format-ethernet": "eth {ipaddr}/{cidr}",
    "tooltip-format": "{essid}\n{ifname} via {gwaddr}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "no wifi",
    "on-click": "alacritty -e nmcli device wifi rescan; alacritty -e nmtui",
  },
  "bluetooth": {
    "format": "bt on",
    "format-off": "bt off",
    "format-disabled": "bt off",
    "format-connected": "bt {num_connections}",
    "on-click": "blueman-manager",
    "tooltip-format": "{status}"
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "vol {volume}% | {format_source}",
    "format-muted": "mute | {format_source}",
    "format-source": "mic on",
    "format-source-muted": "mic off",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "custom/media": {
    "format": "{icon} {}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜"
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}

