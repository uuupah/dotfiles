// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "title_bar": {
    // "show_menus": true
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "ui_font_size": 14,
  "unstable.ui_density": "compact",
  "ui_font_family": "ProggyDotted",
  "buffer_font_family": "ProggyClean Nerd Font Mono",
  "buffer_font_size": 16,
  "buffer_line_height": {
    "custom": 1
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Everforest Dark Medium"
  },
  "terminal": {
    "font_family": "ProggyClean Nerd Font Mono",
    "font_size": 16,
    "line_height": {
      "custom": 1
    }
  },
  "tab_size": 2,
  "languages": {
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width",
      "show_completions_on_input": false
    }
  },
  // hide all the ai nonsense
  "features": {
    "copilot": false,
    "edit_prediction_provider": "none"
  },
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": "never"
  },
  "agent": {
    "enabled": false,
    "button": false
  },
  "assistant_v2": {
    "enabled": false
  },
  "soft_wrap": "editor_width"
}
