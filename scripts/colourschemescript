#!/usr/bin/env bash

homedir="/home/uuu"

hextohsl() {	
  echo $(magick xc:"$1" -colorspace HSL -format "%[pixel:u]" info: | sed 's/hsl(//;s/%)//g;s/)//' | awk -F',' '{printf "%.0f,%.0f,%.0f\n", $1, $2, $3}')
}

# depth 8 gives you single precision hex
hsltohex() {	
  echo $(magick canvas:"hsl($1,$2%,$3%)" -depth 8 -format "%[hex:u]" info:)
}

